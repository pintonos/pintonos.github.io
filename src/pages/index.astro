---
import Layout from '../layouts/Layout.astro'

import { profile } from '@/settings'
import { publications } from '@/data/cv'
import ProfilePictures from '@/assets/profile_pictures.jpg'
import Hero from '@/components/ui/Hero.astro'
import Grid from '@/components/ui/Grid.astro'
import ArticleList from '@/components/ui/ArticleList.astro'

const { fullName, title, credential, institute, research_areas } = profile
---

<Layout>
	<!-- Hero Section -->
	<section class='flex flex-col-reverse md:flex-row items-center gap-8 md:gap-12 border-b border-base-300 pb-12'>
		<Hero
			fullName={fullName}
			title={title}
			credential={credential}
			institute={institute}
			profilePicture={ProfilePictures}
		/>
	</section>

	<!-- Research Areas -->
	<section class='py-12 border-b border-base-300'>
		<Grid gridTitle='Research Areas' gridItems={research_areas} />
	</section>

	<!-- Recent Publications -->
	<section class='py-12'>
		<ArticleList listTitle='Recent Publications' listItems={publications.slice(0, 4)} />
	</section>
</Layout>
