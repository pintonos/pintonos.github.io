---
interface Props {
  listTitle: string;
  listItems: {
    title: string;
    journal: string;
    time: string;
    link?: string;
  }[];
}
const {listTitle, listItems} = Astro.props
---

<div class='flex justify-between items-center mb-8'>
	<h2 class='text-3xl font-bold m-0'>{listTitle}</h2>
	<a href='/papers' class='text-primary hover:underline text-sm font-medium'>View all publications &rarr;</a>
</div>
<div class='space-y-6'>
	{
		listItems.map(item => (
			<div class='p-6 rounded-lg text-base-content bg-base-200'>
				<h3 class='text-xl font-semibold mb-2'>
					{item.link ? (
						<a href={item.link} target='_blank' rel='noopener noreferrer' class='hover:text-primary transition-colors'>
							{item.title}
						</a>
					) : (
						item.title
					)}
				</h3>
				<p class='text-base-content/70'>
					{item.journal} • {item.time}
				</p>
			</div>
		))
	}
</div>
