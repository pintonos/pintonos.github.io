---
import {profile} from '../../settings'
import SocialIcons from './SocialIcons.astro'
import { getCollection } from 'astro:content'
import { template } from '@/settings'

const isBlogPopulated = await getCollection('blog').then(collection => collection.length > 0)

const {fullName, title, credential} = profile

const path = Astro.url.pathname.replace(/\/$/, '') || '/'
const links = [
	{ href: '/', label: 'Home' },
	{ href: '/research', label: 'Research' },
	{ href: '/papers', label: 'Papers' },
	{ href: '/cv', label: 'CV' },
	...(isBlogPopulated ? [{ href: '/blog/1', label: 'Blog' }] : []),
]
const isActive = (href: string) => href === '/' ? path === '/' : path.startsWith(href.replace(/\/1$/, ''))
---
<aside
	class='px-4 pt-4 h-screen w-[20rem] bg-base-200 text-base-content flex flex-col'
>
	<div class='flex flex-col my-8 justify-between h-full'>
		<div>
			<div class='flex flex-col px-4'>
				<p class='text-2xl font-black leading-tight'>{fullName}</p>
				<p class='text-sm text-base-content/70 mt-1'>{title} · {credential}</p>
			</div>
			<div class='mx-2 mt-10'>
				<ul class='space-y-2 menu grow shrink menu-md overflow-y-auto w-full'>
					{links.map(({ href, label }) => (
						<li>
							<a href={`${template.base}${href}`} class:list={['text-lg', { 'bg-primary/15 text-primary font-semibold': isActive(href) }]} aria-current={isActive(href) ? 'page' : undefined}>{label}</a>
						</li>
					))}
				</ul>
			</div>
		</div>
		<div class='mx-4'>
			<SocialIcons/>
		</div>
	</div>
</aside>
